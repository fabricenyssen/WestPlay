new file mode 100644
index 0000000..f5cc089
--- /dev/null
+++ b/ui/src/cabin/apps/musicWithGame.test.ts
@@ -0,0 +1,122 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { MusicPlayer } from './musicWithGame'
+
+/** A player playing or not, recording what it was asked; `volume` null: no volume to fade (plays at once). */
+function player() {
+  const state = { playing: true, pauses: 0, resumes: 0 }
+  const music: MusicPlayer = {
+    name: `player-${Math.random()}`,
+    playingHere: () => state.playing,
+    pauseHere: () => {
+      state.playing = false
+      state.pauses += 1
+    },
+    resumeHere: () => {
+      state.playing = true
+      state.resumes += 1
+    },
+    volume: () => null,
+    sendVolume: () => {},
+    setVolume: () => {},
+    subscribe: () => () => {},
+  }
+  return { music, state }
+}
+
+/** Everything loaded fresh with a window of its own (the stores read it), and the truck's screen's power at hand. */
+async function setup() {
+  // In the host (WebView2's `chrome.webview`, here a stand-in that does nothing): the stores' own setup reads it.
+  vi.stubGlobal('window', {
+    chrome: { webview: { addEventListener: () => {}, removeEventListener: () => {}, postMessage: () => {} } },
+  })
+  const { pauseMusicWithGame } = await import('./musicWithGame')
+  const { useCabin, useLive } = await import('../state/store')
+  const { INITIAL_POWER } = await import('../state/power')
+  const power = (phase: 'off' | 'splash' | 'connecting' | 'on') =>
+    useCabin.setState({ power: { phase, since: 0, observed: true } })
+  useCabin.setState({ power: INITIAL_POWER })
+  return { pauseMusicWithGame, useLive, power }
+}
+
+const telemetry = { paused: false } as never
+
+describe('the music with the electrics', () => {
+  beforeEach(() => {
+    vi.useFakeTimers()
+  })
+  afterEach(() => {
+    vi.useRealTimers()
+    vi.unstubAllGlobals()
+    vi.resetModules()
+  })
+
+  it('stops as the electrics go off and plays on by itself once the screen is back up', async () => {
+    const { pauseMusicWithGame, useLive, power } = await setup()
+    useLive.setState({ telemetry, gameShown: true })
+    power('on')
+    const { music, state } = player()
+    const stop = pauseMusicWithGame(music)
+
+    power('off')
+    expect(state.playing).toBe(false)
+    expect(state.pauses).toBe(1)
+    // Not while the truck boots its screen, only once it is up.
+    power('splash')
+    power('connecting')
+    expect(state.resumes).toBe(0)
+    power('on')
+    expect(state.resumes).toBe(1)
+    expect(state.playing).toBe(true)
+    // Only once: the screen going off and on again with nothing playing before is left alone.
+    state.playing = false
+    power('off')
+    power('on')
+    expect(state.resumes).toBe(1)
+    stop()
+  })
+
+  it('leaves music the player had paused paused', async () => {
+    const { pauseMusicWithGame, useLive, power } = await setup()
+    useLive.setState({ telemetry, gameShown: true })
+    power('on')
+    const { music, state } = player()
+    state.playing = false
+    const stop = pauseMusicWithGame(music)
+    power('off')
+    power('on')
+    expect(state.resumes).toBe(0)
+    stop()
+  })
+
+  it('does not play on at the next game when the game itself was closed', async () => {
+    const { pauseMusicWithGame, useLive, power } = await setup()
+    useLive.setState({ telemetry, gameShown: true })
+    power('on')
+    const { music, state } = player()
+    const stop = pauseMusicWithGame(music)
+    // The game closing: its telemetry gone first, then the screen off (as `connectHost` does).
+    useLive.setState({ telemetry: null })
+    power('off')
+    useLive.setState({ telemetry })
+    power('on')
+    expect(state.resumes).toBe(0)
+    stop()
+  })
+
+  it('waits for the player to come back to the game if the screen is back up while they are away', async () => {
+    const { pauseMusicWithGame, useLive, power } = await setup()
+    useLive.setState({ telemetry, gameShown: true })
+    power('on')
+    const { music, state } = player()
+    const stop = pauseMusicWithGame(music)
+    power('off')
+    // Away (the game's window minimised) as the screen comes up: nothing yet.
+    useLive.setState({ gameShown: false })
+    power('on')
+    expect(state.resumes).toBe(0)
+    // Back: it plays on.
+    useLive.setState({ gameShown: true })
+    expect(state.resumes).toBe(1)
+    stop()
+  })
+})
