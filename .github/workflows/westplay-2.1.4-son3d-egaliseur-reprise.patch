 export function poweredOff(wasOff: boolean, off: boolean): boolean {
   return off && !wasOff
 }
+
+/** Whether the screen just came back up (its power sequence over: `on`) after the electrics were off: the music
+ * that was stopped as they went off plays on, as the radio of a car does as the engine starts. */
+export function poweredOn(wasOn: boolean, on: boolean): boolean {
+  return on && !wasOn
+}
+
+/** What to do with the music as the screen comes back up: play on if it was playing when the electrics went off
